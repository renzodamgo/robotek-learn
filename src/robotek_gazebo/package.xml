<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotek_gazebo</name>
  <version>0.1.0</version>
  <description>
    Gazebo (Harmonic / gz-sim 8) simulation package for the Robotek vehicle.
    Provides the WRO 2026 Future Engineers game field worlds; the car comes from robotek_description.
  </description>
  <maintainer email="renzo.damian.go@gmail.com">Renzo Damian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies used by the launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- ROS 2 <-> Gazebo bridge, used by launch/robotek_sim.launch.py -->
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <!-- Robot description / TF -->
  <exec_depend>robotek_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
