<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotek_course</name>
  <version>0.1.0</version>
  <description>
    Course helpers for building an Open Challenge strategy: launch files for a round, the round recorder
    (starts the round, records the true pose, ends it), the score command, a mini simulator and the base
    class that every student strategy extends.
  </description>
  <maintainer email="renzo.damian.go@gmail.com">Renzo Damian</maintainer>
  <license>MIT</license>


  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>
  <depend>robotek_common</depend>
  <depend>robotek_evaluation</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>robotek_description</exec_depend>
  <exec_depend>robotek_gazebo</exec_depend>
  <exec_depend>robotek_hardware</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
