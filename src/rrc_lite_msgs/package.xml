<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rrc_lite_msgs</name>
  <version>0.0.1</version>
  <description>Mensajes y servicios de la placa HiWonder RRC Lite (con SetAckerServoState para el servo de direccion). Basado en Hiwonder MentorPi.</description>
  <maintainer email="renzo.damian.go@gmail.com">Renzo Damian</maintainer>
  <license>Hiwonder (con permiso); cambios del equipo Robotek: MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>std_msgs</depend>

  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
